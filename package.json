{
  "name": "sahi",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "description": "Quizei — absurd-but-true trivia arena. Yes/No, Fermi estimation and cross-domain comparison, in Turkish and English.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run validate:questions && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
